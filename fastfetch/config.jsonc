//  https://github.com/m3tozz/FastCat
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
            "color": {
        "1": "0"
    }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "os",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "1",
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "1",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "1", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "1", 
        },
                        {
            "type": "de",
            "key": " ",
            "keyColor": "1"
        },

        {
            "type": "wm",
            "key": " ",
            "keyColor": "1", 
        },
        {
            "type": "custom",
            "key": "󰉼 ",
            "keyColor": "1",
            "format": "GTK Catppuccin Mocha"
        },
          
        {
            "type": "cursor",
            "key": " ",
            "keyColor": "1", 
        },
      
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "1", 
        },
        {
           "type": "command",
           "key": ">  OS Age ",
           "keyColor": "1",
           "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
                {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "1"
        },
             
        {
            "type": "monitor",
            "key": " ",
            "keyColor": "1",
            "format": "{name}"
        },
        ]
}

